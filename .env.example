# Kopiera till .env och fyll i. .env checkas aldrig in i git.

# --- Claude (manus, idéer, titlar, val av thumbnail) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# --- Röst (text-to-speech): openai eller elevenlabs ---
TTS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Lugna röster att testa: onyx, sage, ash, ballad
OPENAI_TTS_VOICE=onyx

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Stockfilm: minst en av dessa (båda gratis) ---
# Pixabay: skapa konto, nyckeln står på https://pixabay.com/api/docs/ (sök "key")
PIXABAY_API_KEY=
# Pexels: https://www.pexels.com/api/ (delar inte ut nya nycklar just nu)
PEXELS_API_KEY=

# --- YouTube ---
GOOGLE_CLIENT_SECRET_FILE=secrets/client_secret.json
GOOGLE_TOKEN_FILE=secrets/token.json

# Godkänn före publicering (true = videon laddas upp som privat och väntar på dig)
APPROVAL_REQUIRED=true
# Markera AI-innehåll (AI-röst) i YouTube och i beskrivningen
AI_DISCLOSURE=true

# Valfritt: sökväg till ett fett typsnitt för thumbnails (.ttf/.otf)
FONT_PATH=

# --- Clipper (python -m clipper): YouTube-klipp till TikTok ---
# Whisper används som reserv när videon saknar undertexter (OPENAI_API_KEY ovan)
# TikTok-app från https://developers.tiktok.com (se README)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/tiktok/callback
# inbox = utkast i TikTok-appen (fungerar direkt), direct = publicera (kräver granskad app för offentligt)
TIKTOK_MODE=inbox
# Bara för direct: SELF_ONLY, MUTUAL_FOLLOW_FRIENDS, FOLLOWER_OF_CREATOR eller PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY
